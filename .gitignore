.idea

# BMad-generated agent runtimes — install bmad locally instead of cloning these
.agents/
.claude/skills/
.opencode/

# Gradle build output, per service (there is no root build -- AD-52)
services/*/build/
services/*/.gradle/

# The static-analysis config copied into each service at build time by `make build`.
# It is a generated artifact: regenerated every build
services/*/build/static-analyzers/

# GRADLE_USER_HOME for the containerized build/test runner.
.gradle-home/

# Local compose environment (generated by `make`)
infra/.env

# Machine-local Claude Code settings: absolute home paths and per-developer tool
# permission grants. Never shared -- committing it applies one developer's grants to
# everyone who clones.
.claude/settings.local.json

# Materialised copy of the index, created and removed by .githooks/pre-commit so the
# commit gate analyses what is being committed rather than the working tree.
.pre-commit-tree/
